# Application Environment
ENVIRONMENT=development
APP_NAME=CodeLensAI
DEBUG=true

# Server
HOST=0.0.0.0
PORT=8000

# CORS
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=codelensai

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# Authentication (JWT)
JWT_SECRET_KEY=change_this_to_a_secure_random_secret_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# AI Providers & Fallback (Primary: OpenRouter, Fallbacks: Gemini, OpenAI)
AI_PRIMARY_PROVIDER=openrouter
OPENROUTER_API_KEY=your_openrouter_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# AI Default Models
OPENROUTER_DEFAULT_MODEL=anthropic/claude-3.5-sonnet
GEMINI_DEFAULT_MODEL=gemini-1.5-pro
OPENAI_DEFAULT_MODEL=gpt-4o

# Storage Configuration (local for dev)
STORAGE_TYPE=local
LOCAL_STORAGE_PATH=./storage/repositories
